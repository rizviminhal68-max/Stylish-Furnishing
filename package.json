{
  "name": "stylish-furnishing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketing website for Mizan Sofa Repair - sofa and furniture repair and furnishing services in Gurugram.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "smoke": "vite build --config vite.smoke.config.ts --logLevel error && node dist-smoke/smoke.js",
    "verify": "npm run lint && npm run typecheck && npm run smoke && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.3.1"
  }
}
